---
// Sovereign-console HUD bar: realms, vassals, protocols
import BayjfLink from "@bay/landing-ui/components/BayjfLink.astro";
import StarOnGithub from "@bay/landing-ui/components/StarOnGithub.astro";
import Logo from "./Logo.astro";
import { getLangFromUrl, useTranslations, getAltLangPath, localizePath } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altPath = getAltLangPath(Astro.url, lang);
---

<header class="hud">
  <div class="hud__inner shell">
    <!-- left: brand -->
    <a class="hud__brand" href={localizePath("/", lang)} aria-label={t("hud.home")}>
      <Logo />
      <span class="hud__logo">ZEUS</span>
      <span class="led" data-c="power" aria-hidden="true"></span>
    </a>

    <!-- center: resources -->
    <div class="hud__group">
      <div class="hud__res">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--power)" stroke-width="1.8"><path d="M12 2 3 7v10l9 5 9-5V7z"/><path d="M12 22V12M3 7l9 5 9-5"/></svg>
        <span class="readout" id="res-realms">2</span>
        <span class="hud__label">{t("hud.res.realms")}</span>
      </div>
      <div class="hud__res">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--data)" stroke-width="1.8"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c.6-3.2 3-5 5.5-5s4.9 1.8 5.5 5"/><circle cx="17" cy="9" r="2.4"/><path d="M16.5 14.6c2.2.3 3.9 1.9 4.4 4.4"/></svg>
        <span class="readout" id="res-vassals">1</span>
        <span class="hud__label">{t("hud.res.vassals")}</span>
      </div>
      <div class="hud__res">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h10"/><circle cx="19" cy="17" r="2.2"/></svg>
        <span class="readout">3</span>
        <span class="hud__label">{t("hud.res.protocols")}</span>
      </div>
    </div>

    <!-- right: clock + status -->
    <div class="hud__group hud__group--right">
      <div class="hud__stat">
        <span class="led" data-c="data" aria-hidden="true"></span>
        <span class="readout">REALM NOMINAL</span>
      </div>
      <div class="hud__stat">
        <span class="readout" id="res-clock">--:--:--</span>
      </div>
      <div class="hud__ext">
        <BayjfLink size={17} />
        <StarOnGithub href="https://github.com/bayernjf/zeus" size={15} />
      </div>
      <a class="lang-switch" href={altPath} hreflang={lang === "zh" ? "en" : "zh-CN"}>
        {t("nav.langSwitch")}
      </a>
    </div>
  </div>
  <div class="hud__glow" aria-hidden="true"></div>
</header>

<style>
  .hud {
    position: sticky;
    top: 0;
    z-index: 50;
    background: linear-gradient(180deg, var(--steel-900) 0%, var(--steel-850) 100%);
    border-bottom: 1px solid var(--steel-600);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.7);
  }
  .hud__glow {
    height: 1px;
    background: linear-gradient(90deg, transparent 10%, var(--power) 40%, var(--data) 60%, transparent 90%);
    opacity: 0.18;
  }
  .hud__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    gap: 16px;
  }
  .hud__group {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .hud__group--right {
    gap: 20px;
  }
  .hud__res {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
  }
  .hud__res .readout {
    font-size: 15px;
    color: var(--ink);
  }
  .hud__label {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
    align-self: flex-end;
    margin-bottom: 1px;
  }
  .hud__brand {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: none;
    --logo-size: 22px;
  }
  .hud__logo {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.28em;
    background: linear-gradient(90deg, var(--power), var(--data));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hud__stat {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-dim);
  }
  .hud__stat .readout {
    font-size: 11px;
  }
  .hud__ext {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-left: 18px;
    border-left: 1px solid var(--steel-600);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }
  .hud__ext :global(a) {
    transition: color 160ms ease-out;
  }
  .hud__ext :global(a:hover) {
    color: var(--data);
  }

  @media (max-width: 1100px) {
    .hud__group--right .hud__stat:first-child { display: none; }
  }
  @media (max-width: 1000px) {
    .hud__res .hud__label { display: none; }
    .hud__group { gap: 16px; }
  }
  @media (max-width: 900px) {
    .hud__ext { display: none; }
  }
  @media (max-width: 720px) {
    .hud__inner { height: 44px; }
    .hud__logo { font-size: 12px; letter-spacing: 0.2em; }
    .hud__brand { gap: 7px; --logo-size: 19px; }
    .hud__res:not(:first-child) { display: none; }
  }
  @media (max-width: 560px) {
    .hud__group--right .hud__stat { display: none; }
  }
  @media (max-width: 360px) {
    .hud__group:not(.hud__group--right) { display: none; }
  }
</style>
