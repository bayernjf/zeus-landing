---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Zeus — not found">
  <main>
    <section class="doc">
      <div class="shell">
        <div class="panel panel--riveted doc__panel">
          <h1>404 · off the map</h1>
          <p class="doc__stamp">This realm does not exist.</p>
          <p class="doc__body">
            <p>The path you asked for has no manifest entry. The treasure map only lists vaults that really exist.</p>
          </p>
          <a class="btn btn--ghost doc__back" href="/">Back to the throne</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
